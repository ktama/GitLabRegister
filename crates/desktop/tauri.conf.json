{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitLabRegister",
  "version": "0.1.0",
  "identifier": "jp.local.gitlabregister",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "GitLabRegister",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "targets": []
  }
}
